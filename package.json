{
  "name": "loadly",
  "version": "0.1.0",
  "description": "Small, accessible CSS loading spinners. Reduced-motion and forced-colors aware.",
  "license": "MIT",
  "author": "adam123gale-byte",
  "type": "module",
  "sideEffects": ["*.css"],
  "files": ["src"],
  "exports": {
    "./tokens.css": "./src/_shared.css",
    "./orbit.css": "./src/orbit.css",
    "./ring.css": "./src/ring.css",
    "./pulse.css": "./src/pulse.css",
    "./dots.css": "./src/dots.css",
    "./bars.css": "./src/bars.css",
    "./grid.css": "./src/grid.css",
    "./square.css": "./src/square.css",
    "./sweep.css": "./src/sweep.css",
    "./src/*": "./src/*"
  },
  "keywords": [
    "css", "spinner", "spinners", "loader", "loaders", "loading",
    "accessibility", "a11y", "reduced-motion", "forced-colors",
    "css-only", "no-javascript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/adam123gale-byte/loadly.git"
  },
  "engines": { "node": ">=18" }
}
